<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityManager.getRestrictBackgroundStatus (Data Saver line in the log) throws SecurityException without it:
         builds 2-4 crashed on start. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Custom Tabs need the browser to be visible to the app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask: a redirect back into the app clears the Custom Tab above it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The app's own scheme (= applicationId, com.rawmahn.datchart.oauthspike): custom-scheme redirect (:/oauth),
                 https bounce page (:/https) and the "back to app" link (:/back). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
